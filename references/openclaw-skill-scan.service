[Unit]
Description=OpenClaw: scan managed skills after a directory change

[Service]
Type=oneshot
# Default installation example. Change this path for a ClawHub alias or profile.
# Also set OPENCLAW_STATE_DIR and OPENCLAW_WORKSPACE_DIR when needed.
ExecStart=%h/.openclaw/skills/openclaw-skill-scanner/scripts/auto_scan_user_skills.sh
UMask=0077
